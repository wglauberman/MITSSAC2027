NEWcommon_challenge_typeB <- common_challenge_typeB |>
  mutate(
    challenge_prop = challenge_rate / 100,
    #sqrt(p*(1-p)/n)
    se_prop = sqrt((challenge_prop * (1 - challenge_prop)) / total_pitches),
    se_percent = se_prop * 100,
    lower_ci = challenge_rate - 1.645 * se_percent,
    upper_ci = challenge_rate + 1.645 * se_percent,
    lower_ci = pmax(lower_ci, 0),
    upper_ci = pmin(upper_ci, 100)
  )

