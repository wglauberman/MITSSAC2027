# Model 7: Team-level proportion with weights
# Aggregate to team level with total challenges as weights
team_success <- model_data %>%
  group_by(team_name) %>%
  summarise(
    successes = sum(is_overturned == TRUE, na.rm = TRUE),
    total = n(),
    avg_rSZ = mean(rSZ, na.rm = TRUE),
    avg_OAA = mean(OAA, na.rm = TRUE)
  )

View(team_success)
glm_proportion <- glm(cbind(successes, total - successes) ~ avg_rSZ + avg_OAA,
                      data = team_success,
                      family = binomial)
summary(glm_proportion)


